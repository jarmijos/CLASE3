<?xml version="1.0" encoding="utf-8" ?>
<Window xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CLASE3.Views.NewWindow1"
             Title="NewWindow1">
    <ContentPage>
        <Grid Padding="30"
              RowDefinitions="Auto,Auto,Auto,Auto"
              RowSpacing="16"
              VerticalOptions="Center">
            <Label Grid.Row="0"
                   Text="Registrarse"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,0,0,12" />

            <Entry Grid.Row="1"
                   Placeholder="Registre su usuario"
                   ClearButtonVisibility="WhileEditing"
                   x:Name="txtUsuario" />

            <Entry Grid.Row="2"
                   Placeholder="Registre su Contraseña"
                   ClearButtonVisibility="WhileEditing"
                   IsPassword="True"
                   x:Name="txtContraseña" />

            <Button Grid.Row="3"
                    Text="Registrarse"
                    HorizontalOptions="Fill"
                    Margin="0,8,0,0"
                    Clicked="Guardar_Clicked" />
        </Grid>
    </ContentPage>
</Window>
